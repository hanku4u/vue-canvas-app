{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [],
  "files": ["src/app/config.ts", "src/api/types.ts", "src/api/adminTypes.ts"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "package/dist/types",
    "paths": { "@/*": ["./src/*"] },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.package.tsbuildinfo"
  }
}

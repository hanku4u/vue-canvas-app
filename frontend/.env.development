# Serve /api from the in-browser MSW mock (see docs/frontend-roadmap.md, "Backend dependency strategy").
# Set to 0 (or override in .env.development.local) to use the FastAPI backend through the Vite proxy.
VITE_API_MOCK=1

# Proxy targets (dev server only)
# API_PROXY_TARGET=http://127.0.0.1:8000
# MOCK_DATA_PROXY_TARGET=http://127.0.0.1:8001
